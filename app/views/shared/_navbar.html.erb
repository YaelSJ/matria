<nav class="matria-navbar" aria-label="Navegación principal">
  <div class="matria-navbar__bar">
    <%= link_to root_path, class: "matria-navbar__brand", aria: { label: "Ir al inicio" } do %>
      <%= image_tag "logo.matria.png", alt: "Matr.IA" %>
    <% end %>

    <button
      class="matria-navbar__toggle"
      type="button"
      data-bs-toggle="offcanvas"
      data-bs-target="#matriaMenu"
      aria-controls="matriaMenu"
      aria-label="Abrir menú">

      <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
  </div>

  <div
    class="offcanvas offcanvas-start matria-menu"
    tabindex="-1"
    id="matriaMenu"
    aria-labelledby="matriaMenuTitle">

    <div class="matria-menu__header">
      <%= link_to root_path, class: "matria-menu__brand", aria: { label: "Ir al inicio" } do %>
        <%= image_tag "logo.matria.png", alt: "Matr.IA" %>
      <% end %>

      <button
        type="button"
        class="matria-menu__close"
        data-bs-dismiss="offcanvas"
        aria-label="Cerrar menú">

        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>

    <div class="matria-menu__body">
      <% if user_signed_in? %>
        <p class="matria-menu__label">Menú principal</p>

        <ul class="matria-menu__list">
          <li>
            <%= link_to dashboard_path,
                        class: "matria-menu__link #{'is-active' if current_page?(dashboard_path)}" do %>
              <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
              <span>Dashboard</span>
            <% end %>
          </li>

          <% if current_user.representative? || current_user.admin? %>
            <li>
              <%= link_to dashboard_path(tab: "assigned"),
                          class: "matria-menu__link #{'is-active' if params[:tab] == 'assigned'}" do %>
                <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                <span>Mis casos asignados</span>
              <% end %>
            </li>

            <li>
              <%= link_to dashboard_path(tab: "state"),
                          class: "matria-menu__link #{'is-active' if params[:tab] == 'state'}" do %>
                <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                <span>Casos de mi estado</span>
              <% end %>
            </li>
          <% elsif current_user.case.present? %>
            <li>
              <%= link_to case_path(current_user.case), class: "matria-menu__link" do %>
                <i class="fa-regular fa-folder-open" aria-hidden="true"></i>
                <span>Mi caso</span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <div class="matria-menu__divider"></div>

        <p class="matria-menu__label">Cuenta</p>

        <ul class="matria-menu__list">
          <li>
            <%= link_to "#", class: "matria-menu__link" do %>
              <span class="matria-menu__avatar" aria-hidden="true">
                <i class="fa-solid fa-user"></i>
              </span>
              <span>Mi perfil</span>
            <% end %>
          </li>

          <li>
            <%= link_to destroy_user_session_path,
                        data: { turbo_method: :delete },
                        class: "matria-menu__link matria-menu__link--logout" do %>
              <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
              <span>Cerrar sesión</span>
            <% end %>
          </li>
        </ul>
      <% else %>
        <div class="matria-menu__guest">
          <p>Bienvenida a MatrIA</p>

          <%= link_to "Iniciar sesión",
                      new_user_session_path,
                      class: "matria-menu__login" %>
        </div>
      <% end %>
    </div>

    <div class="matria-menu__footer">
      <%= image_tag "logo-FNCVV.png",
                    class: "matria-menu__footer-logo",
                    alt: "Frente Nacional Contra Violencia Vicaria" %>
    </div>

  </div>
</nav>
