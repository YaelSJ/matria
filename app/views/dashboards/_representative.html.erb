<button
  type="button"
  class="dashboard__shortcut"
  >
  <span class="dashboard__shortcut-icon" aria-hidden="true">
    <i class="fa-solid fa-book-open"></i>
  </span>

  <span class="dashboard__shortcut-copy">
    <span class="dashboard__shortcut-title">Recursos de apoyo</span>
    <span class="dashboard__shortcut-description">
      Guías de denuncia y canales de apoyo
    </span>
  </span>

  <i
    class="fa-solid fa-chevron-right dashboard__chevron"
    aria-hidden="true"></i>
</button>

<nav class="dashboard__tabs" aria-label="Listas de casos">
  <%= link_to "Mis casos asignados",
              dashboard_path(tab: "assigned"),
              class: "dashboard__tab",
              aria: {
                current: (@active_tab == "assigned" ? "page" : nil)
              } %>

  <%= link_to "Casos de mi estado",
              dashboard_path(tab: "state"),
              class: "dashboard__tab",
              aria: {
                current: (@active_tab == "state" ? "page" : nil)
              } %>
</nav>

<% risk_labels = {
  "critical" => "Crítico",
  "high" => "Alto",
  "medium" => "Medio",
  "low" => "Bajo"
} %>

<% if @cases.any? %>
  <p class="dashboard__label mb-3">
    Ordenados por nivel de riesgo
  </p>

  <div class="dashboard__case-list">
    <% @cases.each do |case_record| %>
      <section class="dashboard__card">
        <div class="dashboard__card-header">
          <h2 class="dashboard__card-title">
            Caso #<%= case_record.id %>
          </h2>

          <span class="dashboard__status">
            Riesgo: <%= risk_labels.fetch(case_record.risk_level) %>
          </span>
        </div>

        <% if @active_tab == "state" %>
          <p class="dashboard__assignment">
            Representante:
            <% if case_record.representative %>
              <%= case_record.representative.name.presence || "Asignada" %>
            <% else %>
              Sin asignar
            <% end %>
          </p>
        <% end %>

        <div class="dashboard__actions">
          <button
            type="button"
            class="dashboard__button dashboard__button--secondary"
            >
            Ver caso
          </button>

          <% if policy(case_record).assign? %>
            <button
              type="button"
              class="dashboard__button"
              >
              Asignarme
            </button>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="dashboard__empty">
    <% if @active_tab == "assigned" %>
      <p>Aún no tienes casos asignados</p>

      <%= link_to "Casos de mi estado",
                  dashboard_path(tab: "state"),
                  class: "dashboard__button" %>
    <% else %>
      <p>No hay casos disponibles para mostrar en tu estado.</p>
    <% end %>
  </div>
<% end %>
