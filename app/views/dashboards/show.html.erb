<div class="dashboard">
  <div class="dashboard__content <%= 'dashboard__content--representative' if current_user.representative? || current_user.admin? %>">

    <% if current_user.user? && @case %>
      <% status_labels = {
        "draft" => "Borrador",
        "pending_review" => "En revisión",
        "in_review" => "En revisión",
        "changes_requested" => "Acción requerida",
        "approved" => "Aprobado",
        "closed" => "Cerrado"
      } %>

      <section class="user-dashboard">
        <header class="user-dashboard__header">
          <h1>Mi dashboard</h1>
        </header>

        <section class="user-dashboard__case-card" aria-labelledby="user-case-title">
          <div class="user-dashboard__case-header">
            <h2 id="user-case-title">Mi caso</h2>

            <span class="user-dashboard__status user-dashboard__status--<%= @case.status %>">
              <%= status_labels.fetch(@case.status) %>
            </span>
          </div>

          <p class="user-dashboard__label">Última actualización</p>

          <p class="user-dashboard__date">
            <%= @case.updated_at.strftime("%d/%m/%Y") %>
          </p>

          <%= link_to(
            @case.editable_by_user? ? "Continuar con mi caso" : "Ver mi caso",
            case_path(@case),
            class: "user-dashboard__case-button"
          ) %>
        </section>

        <div class="user-dashboard__shortcuts">
          <button type="button" class="user-dashboard__shortcut">
            <span class="user-dashboard__shortcut-icon">
              <i class="fa-regular fa-comment"></i>
            </span>

            <span class="user-dashboard__shortcut-copy">
              <span class="user-dashboard__shortcut-title">Mis Chats</span>
              <span class="user-dashboard__shortcut-description">
                Lista de conversaciones
              </span>
            </span>

            <i class="fa-solid fa-chevron-right user-dashboard__chevron" aria-hidden="true"></i>
          </button>

          <button type="button" class="user-dashboard__shortcut">
            <span class="user-dashboard__shortcut-icon">
              <i class="fa-regular fa-file"></i>
            </span>

            <span class="user-dashboard__shortcut-copy">
              <span class="user-dashboard__shortcut-title">Archivos de mi caso</span>
              <span class="user-dashboard__shortcut-description">
                Archivos relacionados con tu caso
              </span>
            </span>

            <i class="fa-solid fa-chevron-right user-dashboard__chevron" aria-hidden="true"></i>
          </button>
        </div>

        <section class="user-dashboard__message">
          <p>Estamos aquí para acompañarte</p>

          <i class="fa-solid fa-seedling user-dashboard__message-icon" aria-hidden="true"></i>
        </section>
      </section>

    <% elsif current_user.representative? || current_user.admin? %>
      <%= turbo_frame_tag "representative_dashboard",
                          target: "_top",
                          data: { turbo_action: "advance" } do %>
        <%= render "representative" %>
      <% end %>
    <% end %>
  </div>
</div>
