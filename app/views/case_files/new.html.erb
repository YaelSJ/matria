<h1>Subir un archivo prueba</h1>

<%= simple_form_for [@case, @case_file],
      html:{
        class: "audio-recorder",
        data: { controller: "audio-recorder" }
      } do |f| %>
  <div>
    <%= f.input :audio, as: :file, input_html: { data: { audio_recorder_target: "audioInput"}} %>
    <%= f.input :title %>
  </div>

  <div>
    <button
      type="button"
      data-audio-recorder-target="startButton"
      data-action="click->audio-recorder#start">
      Start
    </button>

    <button
      type="button"
      disabled
      data-audio-recorder-target="stopButton"
      data-action="click->audio-recorder#stop">
      Stop
    </button>
  </div>

  <div>
    <%= f.submit "Enviar" %>
  </div>
<% end %>
