<h1>Subir un archivo prueba</h1>

<%= simple_form_for [@case, @case_file] do |f| %>
  <div>
    <%= f.input :audio, as: :file %>
    <%= f.input :title %>
    <%= f.input :state %>
  </div>

  <div>
    <%= f.submit "subir audio" %>
  </div>
<% end %>


