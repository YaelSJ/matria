<main class="authentication authentication--registration">
  <div class="authentication__container">
    <section
      class="authentication__card"
      aria-labelledby="registration-title"
    >
      <header class="authentication__header">
        <h1 id="registration-title" class="authentication__title">
          Crea tu cuenta
        </h1>

        <p class="authentication__description">
          Completa tus datos para comenzar tu proceso en MatrIA.
        </p>
      </header>

      <%= simple_form_for(
        resource,
        as: resource_name,
        url: registration_path(resource_name)
      ) do |f| %>
        <%= f.error_notification %>

        <fieldset class="authentication__section">
          <legend class="authentication__section-title">
            Datos personales
          </legend>

          <div class="authentication__grid">
            <%= f.input(
              :name,
              label: "Nombre",
              required: true
            ) %>

            <%= f.input(
              :last_name,
              label: "Apellido",
              required: true
            ) %>

            <%= f.input(
              :birth_date,
              label: "Fecha de nacimiento",
              as: :date,
              start_year: Date.current.year - 100,
              end_year: Date.current.year,
              order: [:day, :month, :year],
              wrapper_html: {
                class: "authentication__field--full"
              }
            ) %>
          </div>
        </fieldset>

        <fieldset class="authentication__section"
                  data-controller="registration-location"
                  data-registration-location-catalog-value="<%= MexicanLocations.options.to_json %>">
          <legend class="authentication__section-title">Ubicación</legend>
          <p class="authentication__location-hint" id="location-help">
            Selecciona tu país, después tu estado y tu municipio o alcaldía.
          </p>

          <div class="authentication__grid">
            <%= f.input :user_country,
                        label: "País",
                        as: :select,
                        collection: [MexicanLocations::COUNTRY],
                        prompt: "Selecciona tu país",
                        required: true,
                        wrapper_html: { class: "authentication__field--full" },
                        input_html: {
                          autocomplete: "country-name",
                          aria: { describedby: "location-help" },
                          data: { registration_location_target: "country", action: "change->registration-location#countryChanged" }
                        } %>

            <%= f.input :state,
                        label: "Estado",
                        as: :select,
                        collection: MexicanLocations.states,
                        prompt: "Selecciona tu estado",
                        required: true,
                        disabled: resource.user_country != MexicanLocations::COUNTRY,
                        input_html: {
                          autocomplete: "address-level1",
                          data: { registration_location_target: "state", action: "change->registration-location#stateChanged" }
                        } %>

            <%= f.input :city,
                        label: "Municipio / Alcaldía",
                        as: :select,
                        collection: MexicanLocations.municipalities(resource.state),
                        prompt: "Selecciona tu municipio o alcaldía",
                        required: true,
                        disabled: resource.user_country != MexicanLocations::COUNTRY || !MexicanLocations.states.include?(resource.state),
                        input_html: {
                          autocomplete: "address-level2",
                          data: { registration_location_target: "city" }
                        } %>
          </div>
        </fieldset>

        <fieldset class="authentication__section">
          <legend class="authentication__section-title">
            Datos de acceso
          </legend>

          <div class="authentication__grid">
            <%= f.input(
              :email,
              label: "Correo electrónico",
              required: true,
              autofocus: true,
              input_html: {
                autocomplete: "email"
              },
              wrapper_html: {
                class: "authentication__field--full"
              }
            ) %>

            <%= f.input(
              :password,
              label: "Contraseña",
              required: true,
              hint: (
                "#{@minimum_password_length} caracteres como mínimo" if
                  @minimum_password_length
              ),
              input_html: {
                autocomplete: "new-password"
              }
            ) %>

            <%= f.input(
              :password_confirmation,
              label: "Confirmar contraseña",
              required: true,
              input_html: {
                autocomplete: "new-password"
              }
            ) %>
          </div>
        </fieldset>

        <div class="authentication__actions">
          <%= f.button(
            :submit,
            "Crear mi cuenta",
            class: "authentication__submit"
          ) %>
        </div>
      <% end %>

      <div class="authentication__links">
        <%= render "devise/shared/links" %>
      </div>
    </section>
  </div>
</main>
