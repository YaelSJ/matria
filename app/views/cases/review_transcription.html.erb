<div class="case-review">
  <h1>Revisa tu transcripción</h1>

  <p>
    Lee tu testimonio y corrige lo que necesites.
    Al confirmar, enviaremos tu caso a revisión
    a las representantes de tu estado.
  </p>

  <% opening_testimony = @case.opening_testimony %>

  <% if opening_testimony %>
    <%= turbo_stream_from opening_testimony %>
  <% end %>

  <%= render "transcription_review",
            case_record: @case,
            case_file: opening_testimony,
            transcript: @transcript,
            consent: @consent %>
</div>
