<div class="case-review">
  <% if current_user.representative? || current_user.admin? %>
    <% risk_labels = {
      "low" => "Bajo",
      "moderate" => "Moderado",
      "high" => "Alto",
      "extreme" => "Extremo"
    } %>

    <% file_icons = {
      "image" => "fa-image",
      "document" => "fa-file-lines",
      "opening_testimony" => "fa-microphone-lines",
      "additional_audio" => "fa-volume-high",
      "ai_chat" => "fa-comments"
    } %>

    <% file_type_labels = {
      "image" => "Imagen",
      "document" => "Documento",
      "opening_testimony" => "Testimonio inicial",
      "additional_audio" => "Audio adicional",
      "ai_chat" => "Chat de IA"
    } %>

    <header class="case-review__header">
      <div>
        <p class="case-review__eyebrow">Expediente en atención</p>
        <h1>Detalles del caso #<%= @case.id %></h1>
      </div>

      <span class="case-review__status">
        <%= @case.status.humanize %>
      </span>
    </header>

    <div class="case-review__grid">
      <aside class="case-review__column">
        <section class="case-review__card">
          <h2>
            <span class="case-review__icon">
              <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
            </span>
            Resumen y nivel de riesgo
          </h2>

          <p>
            <%= @case.summary.presence ||
                "El resumen estará disponible cuando la usuaria envíe el caso a revisión." %>
          </p>

          <div class="case-review__risk case-review__risk--<%= @case.risk_level %>">
            <span>Nivel de riesgo</span>
            <strong>
              <%= risk_labels.fetch(@case.risk_level, @case.risk_level.humanize) %>
            </strong>
          </div>
        </section>

        <section class="case-review__card" aria-labelledby="case-history-title">
          <h2 id="case-history-title">
            <span class="case-review__icon">
              <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
            </span>
            Historial del expediente
          </h2>

          <% if @case.case_events.any? %>
            <ol class="case-review__timeline">
              <% @case.case_events.order(:created_at).each do |event| %>
                <li>
                  <strong><%= event.event_type.humanize %></strong>

                  <time datetime="<%= event.created_at.iso8601 %>">
                    <%= event.created_at.strftime("%d/%m/%Y · %H:%M") %>
                  </time>

                  <% if event.comment.present? %>
                    <p><%= event.comment %></p>
                  <% end %>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p>Aún no hay eventos registrados.</p>
          <% end %>
        </section>
      </aside>

      <main class="case-review__column">
        <% if policy(@case).view_full_testimony? %>
        <section class="case-review__card" aria-labelledby="representative-files-title">
          <h2 id="representative-files-title">
            <span class="case-review__icon">
              <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
            </span>
            Archivos y evidencia
          </h2>

          <% if @case.case_files.any? %>
            <ul class="case-review__files">
              <% @case.case_files.each do |case_file| %>
                <li>
                  <span class="case-review__file-icon">
                    <i
                      class="fa-solid <%= file_icons.fetch(case_file.file_type, "fa-file") %>"
                      aria-hidden="true">
                    </i>
                  </span>

                  <div>
                    <strong><%= case_file.title %></strong>
                    <small>
                      <%= file_type_labels.fetch(
                        case_file.file_type,
                        case_file.file_type.humanize
                      ) %>
                    </small>

                    <% if case_file.audio.attached? %>
                      <audio controls preload="metadata">
                        <source src="<%= rails_blob_path(case_file.audio, disposition: "inline") %>">
                        Tu navegador no soporta la reproducción de audio.
                      </audio>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p>No hay archivos adjuntos.</p>
          <% end %>
        </section>

        <% else %>
          <p>La usuaria no ha autorizado el acceso a los archivos de su caso.</p>
        <% end %>

        <section class="case-review__card" aria-labelledby="applicant-title">
          <h2 id="applicant-title">Datos de la solicitante</h2>

          <dl class="case-review__person-data">
            <div>
              <dt>
                <i class="fa-solid fa-user" aria-hidden="true"></i>
                Nombre
              </dt>
              <dd>
                <%= [@case.user.name, @case.user.last_name].compact.join(" ").presence ||
                    "No capturado" %>
              </dd>
            </div>

            <div>
              <dt>
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                Ubicación
              </dt>
              <dd>
                <%= [@case.user.city, @case.user.state].compact.join(", ").presence ||
                    "No capturada" %>
              </dd>
            </div>

            <div>
              <dt>
                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                Teléfono
              </dt>
              <dd><%= @case.user.phone_number.presence || "No capturado" %></dd>
            </div>
          </dl>
        </section>

        <% if policy(@case).view_full_testimony? %>
          <section class="case-review__card" aria-labelledby="transcript-title">
            <h2 id="transcript-title">
              <span class="case-review__icon">
                <i class="fa-regular fa-message" aria-hidden="true"></i>
              </span>
              Transcripción
            </h2>

            <p>
              <%= @case.opening_testimony&.transcript.presence ||
                  "Aún no hay una transcripción del testimonio inicial." %>
            </p>
          </section>
        <% else %>
          <p>La usuaria no ha autorizado el acceso a su testimonio completo.</p>
        <% end %>
      </main>

      <aside class="case-review__column">
        <% if policy(@case).assign? %>
          <%= button_to "Asignarme este caso",
                        assign_case_path(@case),
                        method: :patch,
                        class: "case-review__button" %>
        <% end %>

        <% if policy(@case).start_review? %>
          <%= button_to "Comenzar revisión",
                        start_review_case_path(@case),
                        method: :post,
                        class: "case-review__button" %>
        <% end %>

        <% if policy(@case).decide? %>
          <section class="case-review__card" aria-labelledby="case-decision-title">
            <h2 id="case-decision-title">Definir estatus</h2>

            <%= form_with url: decide_case_path(@case),
                          method: :post,
                          class: "case-review__form" do |form| %>

              <%= form.label :decision, "Decisión" %>
              <%= form.select :decision, [
                ["Aprobar", "approved"],
                ["Solicitar cambios", "changes_requested"],
                ["Cerrar expediente", "closed"]
              ] %>

              <%= form.label :comment, "Observaciones" %>
              <%= form.text_area :comment,
                                 placeholder: "Agrega las observaciones para la solicitante" %>

              <%= form.submit "Guardar decisión", class: "case-review__button" %>
            <% end %>
          </section>
        <% end %>
      </aside>
    </div>

  <% else %>
    <% status_labels = {
      "draft" => "Borrador",
      "pending_review" => "Enviado a revisión",
      "in_review" => "En revisión",
      "changes_requested" => "Acción requerida",
      "approved" => "Aprobado",
      "closed" => "Cerrado"
    } %>

    <% file_type_labels = {
      "opening_testimony" => "Testimonio inicial",
      "additional_audio" => "Audio adicional",
      "ai_chat" => "Chat de IA",
      "image" => "Imagen",
      "document" => "Documento"
    } %>

    <header class="case-review__header">
      <div>
        <p class="case-review__eyebrow">Tu expediente</p>
        <h1>Revisión de mi caso</h1>
      </div>

      <span class="case-review__status">
        <%= status_labels.fetch(@case.status, @case.status.humanize) %>
      </span>
    </header>

    <div class="case-review__user-layout">
      <% if @case.changes_requested? %>
        <section class="case-review__user-notice case-review__user-notice--changes"
                 aria-labelledby="changes-request-title">
          <span class="case-review__icon">
            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
          </span>

          <div>
            <h2 id="changes-request-title">Tu expediente necesita una actualización</h2>
            <p>Una representante solicitó información adicional. Revisa sus observaciones, actualiza lo necesario y vuelve a enviar tu caso.</p>

            <% if (changes_request = @case.latest_changes_request)&.comment.present? %>
              <div class="case-review__representative-note">
                <strong>Observaciones de la representante</strong>
                <p><%= changes_request.comment %></p>
              </div>
            <% end %>
          </div>
        </section>
      <% elsif @case.pending_review? %>
        <section class="case-review__user-notice" aria-labelledby="pending-review-title">
          <span class="case-review__icon">
            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
          </span>
          <div>
            <h2 id="pending-review-title">Tu caso fue enviado</h2>
            <p>Una representante de tu estado lo revisará pronto. Te avisaremos si necesita información adicional.</p>
          </div>
        </section>
      <% elsif @case.in_review? %>
        <section class="case-review__user-notice" aria-labelledby="in-review-title">
          <span class="case-review__icon">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          </span>
          <div>
            <h2 id="in-review-title">Tu caso está en revisión</h2>
            <p>La información principal está bloqueada mientras una representante revisa tu expediente.</p>
          </div>
        </section>
      <% elsif @case.editable_by_user? %>
        <section class="case-review__user-notice" aria-labelledby="draft-case-title">
          <span class="case-review__icon">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          </span>
          <div>
            <h2 id="draft-case-title">Tu caso aún no ha sido enviado</h2>
            <p>Revisa tu información y tu testimonio antes de compartirlo con una representante.</p>
          </div>
        </section>
      <% end %>

      <main class="case-review__user-content">
        <section class="case-review__card" aria-labelledby="testimony-title">
          <h2 id="testimony-title">
            <span class="case-review__icon">
              <i class="fa-regular fa-message" aria-hidden="true"></i>
            </span>
            Testimonio inicial
          </h2>

          <% if @case.opening_testimony&.transcript.present? %>
            <p><%= @case.opening_testimony.transcript %></p>
          <% else %>
            <p class="case-review__empty">Aún no has grabado tu testimonio inicial.</p>
          <% end %>
        </section>

        <section class="case-review__card" aria-labelledby="files-title">
          <h2 id="files-title">
            <span class="case-review__icon">
              <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
            </span>
            Archivos del caso
          </h2>

          <% if @case.case_files.any? %>
            <ul class="case-review__files">
              <% @case.case_files.each do |case_file| %>
                <li>
                  <span class="case-review__file-icon">
                    <i class="fa-solid fa-file" aria-hidden="true"></i>
                  </span>
                  <div>
                    <strong><%= case_file.title.presence || file_type_labels.fetch(case_file.file_type) %></strong>
                    <small><%= file_type_labels.fetch(case_file.file_type, case_file.file_type.humanize) %></small>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="case-review__empty">Aún no hay archivos agregados.</p>
          <% end %>
        </section>
      </main>

      <aside class="case-review__user-sidebar">
        <section class="case-review__card" aria-labelledby="case-details-title">
          <h2 id="case-details-title">
            <span class="case-review__icon">
              <i class="fa-solid fa-user" aria-hidden="true"></i>
            </span>
            Datos personales
          </h2>

          <dl class="case-review__person-data">
            <div>
              <dt>Nombre</dt>
              <dd><%= [@case.user.name, @case.user.last_name].compact.join(" ").presence || "No capturado" %></dd>
            </div>
            <div>
              <dt>Ubicación</dt>
              <dd><%= [@case.user.city, @case.user.state].compact.join(", ").presence || "No capturada" %></dd>
            </div>
            <div>
              <dt>Teléfono</dt>
              <dd><%= @case.user.phone_number.presence || "No capturado" %></dd>
            </div>
          </dl>
        </section>

        <% if @case.editable_by_user? %>
          <section class="case-review__card case-review__user-actions" aria-labelledby="case-actions-title">
            <h2 id="case-actions-title">Siguientes pasos</h2>

            <% if @case.opening_testimony&.transcript.present? %>
              <%= link_to "Revisar transcripción y enviar",
                          review_transcription_case_path(@case),
                          class: "case-review__button" %>
            <% else %>
              <%= link_to "Grabar testimonio",
                          new_case_case_file_path(@case),
                          class: "case-review__button" %>
            <% end %>

            <%= link_to "Editar información",
                        edit_case_path(@case),
                        class: "case-review__button case-review__button--secondary" %>
          </section>
        <% end %>
      </aside>
    </div>
  <% end %>
</div>
