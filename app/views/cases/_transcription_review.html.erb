<%= turbo_frame_tag "transcription_review" do %>
  <% if case_file&.transcript.present? %>
    <%= form_with url: confirm_transcription_case_path(case_record),
                  method: :post, data: { turbo_frame: "_top" } do %>

      <%= label_tag :transcript, "Tu transcripción",
                    class: "d-block mb-2" %>

      <%= text_area_tag :transcript,
                        transcript.nil? ? case_file.transcript : transcript,
                        rows: 12,
                        required: true,
                        class: "form-control mb-4" %>

      <p id="consent-explanation">
        Las representantes podrán ver tu nombre, teléfono, un resumen
        generado por IA, tu testimonio completo y los archivos de tu caso.
        Debes aceptar este consentimiento para enviar el caso a revisión.
      </p>

      <div class="form-check mb-4">
        <%= hidden_field_tag :consent, "0" %>

        <%= check_box_tag :consent, "1", consent == true,
                          required: true,
                          class: "form-check-input",
                          aria: { describedby: "consent-explanation" } %>

        <%= label_tag :consent,
                      "Autorizo a las representantes de mi estado a consultar mi testimonio completo y los archivos de mi caso.",
                      class: "form-check-label" %>
      </div>

      <%= submit_tag "Confirmar y continuar",
                      class: "dashboard__button",
                      data: { turbo_submits_with: "Enviando…" } %>
    <% end %>
  <% else %>
    <p>Estamos trabajando en tu audio. Esto puede tomar unos segundos.</p>
  <% end %>
<% end %>
